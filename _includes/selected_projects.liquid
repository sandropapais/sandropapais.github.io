<div class="publications selected-projects">
  {% for project in site.data.selected_projects %}
    <div class="row align-items-center">
      {% if site.enable_publication_thumbnails %}
        <div class="col col-sm-3 abbr">
          {% if project.image %}
            {% assign project_path = project.image | prepend: '/assets/img/' %}
            <img class="preview z-depth-1 rounded img-fluid" src="{{ project_path | relative_url }}" alt="{{ project.title }}" data-zoomable>
          {% endif %}
        </div>
      {% endif %}
      <div class="{% if site.enable_publication_thumbnails %}col-sm-7{% else %}col-sm-10{% endif %}">
        <div class="title">{{ project.title }}</div>
        <div class="periodical">{{ project.description }}</div>
      </div>
    </div>
  {% endfor %}
</div>

<style>
  .selected-projects .row {
    margin-bottom: 1rem;
  }
  /* Match the bold title weight used by the publication entries. */
  .selected-projects .title {
    font-weight: bolder;
  }
</style>
